{
  "name": "@harzva/dsh-terminal",
  "version": "0.1.0-alpha.5",
  "private": true,
  "type": "module",
  "description": "DSH SuperTerminal: resizable terminals, local agent library, and DSH-powered command advice",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harzva/dsh-superterminal.git"
  },
  "homepage": "https://github.com/Harzva/dsh-superterminal#readme",
  "bugs": {
    "url": "https://github.com/Harzva/dsh-superterminal/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "terminal",
    "pty",
    "agents"
  ],
  "exports": {
    ".": "./lib/host.mjs",
    "./client": "./lib/client.js",
    "./remote": "./lib/remote.mjs",
    "./typert": "./lib/remote.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "pack:dsh": "node scripts/pack-dsh.mjs",
    "verify:dsh-offline": "node scripts/verify-dsh-offline.mjs"
  },
  "dependencies": {
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "@types/react": "18.3.27",
    "typescript": "5.9.3"
  }
}
